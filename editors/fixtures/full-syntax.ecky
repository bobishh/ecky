(list? value)

; CAD operations - primitives
(box 40 20 10 :align '(min center min))

(sphere 12)

(cylinder 8 30)

(cone 12 6 30)

(circle 20)

(ring 20 10)

(rectangle 40 20)

(rounded-rect 40 20 3)

(rounded-polygon points 2)

(polygon ((0 0) (40 0) (40 20) (0 20)))

(profile :outer (circle 20) :holes (circle 6))

(make-face (polygon points))

(text "A" 12)

(svg iconData)

(import-stl "/tmp/part.stl")

; CAD operations - paths
(path (polyline points))

(polyline ((0 0) (10 0) (10 5)))

(bezier-path points)

(bspline points :closed #t)

; CAD operations - solid modifiers
(extrude (polygon points) 8)

(revolve profile 360)

(loft bottom top)

(sweep (circle 2) rail)

(helical-ridge :radius 32 :pitch 5.25 :height 16.8 :base-width 1.45 :crest-width 0.55 :depth 1.5)

(thread :radius 8 :pitch 2 :length 16 :depth 1)

(tapped-hole :iso "M8" :length 14)

(rib (box 20 20 20) (circle 3) (path (0 0 0) (0 0 30)))

(groove (box 20 20 20) (circle 3) (path (0 0 0) (0 0 30)))

(torus 20 5)

(ellipse 10 4)

(regular-polygon 6 10)

(trapezoid 20 10 8 :skew 3)

(wedge 20 10 20 5 5 15 15)

(slot-overall 40 10)

(slot-center-to-center 30 10)

(slot-center-point 0 0 20 0 10)

(slot-arc 20 0 90 10)

; CAD operations - modifiers
(shell 2 :faces "target-id:body:face:0-0-20:1256.637" (cylinder 20 80))

(offset 2 profile)

(offset-rounded 2 profile)

(fillet 2 :edges "x-min+z-max" body)

(chamfer 1 :edges "bottom" body)

(taper 30 0.7 0.7 (circle 12))

(twist 40 90 profile)

; CAD operations - booleans
(union a b c)

(fuse a b c)

(difference body hole)

(cut body hole)

(intersection a b)

(common a b)

(xor a b)

(compound body bolts)

; CAD operations - transforms
(translate 10 0 0 body)

(rotate 0 0 45 body)

(scale 1 1 0.5 body)

(mirror "x" 0 body)

; CAD operations - arrays
(linear-array 4 12 0 0 rib)

(radial-array 12 30 spoke)

(grid-array 3 5 12 12 hole)

(arc-array 8 30 0 180 notch)

(repeat 6 rib)

(repeat-union 6 rib)

(repeat-compound 6 rib)

(repeat-pick 6 rib)

(for-union (range 6) (lambda (i) ...))

(for-compound points (lambda (p) ...))

; CAD operations - frames and placement
(plane :origin '(80 0 6) :normal '(0 0 1))

(location (plane :origin '(80 0 6)) :rotate '(0 90 0))

(path-frame rail :at end :up '(0 0 1))

(place end-frame (cylinder 4 18) :offset '(0 0 -9))

(clip-box body :x '(0 100) :y '(-30 30) :z '(0 40))

(draft 2 body)

(clip-plane body :origin '(0 0 10) :normal '(0 0 1) :keep positive)

; CAD operations - build
(build (shape body) (result body))

(shape body)

(result body)

; CAD operations - special
(sampled-radial-loft (theta z fz) :height 40 :z-steps 24 :theta-steps 72 :radius (+ 18 (* 2 (sin (+ (* theta 6) (* fz 3.141592653589793))))))

; EckyRust-only operations
(mesh :vertices ((0 0 0) (10 0 0) (0 10 0)) :triangles ((0 1 2)))

(polyhedron :vertices ((0 0 0) (10 0 0) (0 10 0) (0 0 10)) :triangles ((0 2 1) (0 1 3) (1 2 3) (2 0 3)))

(protrude image-path 4 :width 100 :depth 70 :foreground dark)

(wall-pattern (:mode gyroid :depth 0.6 :uFreq 4 :vFreq 5 :seed 7) (shell 2 (cylinder 20 80)))

(hull (sphere 6) (translate 30 0 0 (sphere 6)))

(import-step "/absolute/path/component.step")

(voronoi-cell (voronoi-cells 3 3 12 12 1.5 23) 4 40 40 1.2)

; Mesh/EckyRust surface trim operations
(surface-trim
  (import-stl "/tmp/mesh.stl")
  :loop ((mesh-anchor 0 1 0 0) (mesh-anchor 1 0 1 0) (mesh-anchor 2 0 0 1))
  :keep-seed (mesh-anchor 3 1 0 0))


; Required symbols for testing
(model
  (params (number r 20))
  (part box-part (box 10 10 10))
  (part repeated (repeat 4 (box 5 5 5)))
  (part wall-pattern-part (wall-pattern (:mode gyroid :depth 0.6) (sphere 10)))
  (part radial-loft-part (sampled-radial-loft (theta z fz) :height 20 :z-steps 12 :theta-steps 36 :radius 10)))


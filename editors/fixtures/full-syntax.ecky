; Ecky CAD DSL - Full Syntax Fixture File
; This file tests all canonical syntax elements for editor support

; Comments
; This is a single-line comment
; Another comment with special chars: +-*/<>=?!

; Model clauses
(model
  (params
    (number radius 20 :label "Radius" :min 5 :max 80)
    (number height 30 :label "Height" :min 10 :max 100)
    (boolean useCap #f :label "Use cap"))
  (part body (cylinder radius height))
  (meta :title "Test Model" :version "1.0")
  (verify (tag body) (metric body (stl connected-component-count)) (expect body (= 1)))
  (feature shell :role enclosure :params (radius) (box radius 40 2))
  (tag-vertex datum :vertex "top" body)
  (tag-face mounting :faces "bottom" body)
  (tag-edge rim :edges "top" body)
  (tag-edges rim-pair :edges "top" body)
  (view print-layout (offset-part body 0 0 0))
  (analysis load-case (linear-static :part body) (solve :method direct)))

; Model wrappers
(begin
  (params (number x 10))
  (part base (box x x x)))

(let ((r 20) (h 40))
  (part cylinder-part (cylinder r h)))

(let* ((r 10) (h (* r 3)) (wall 2))
  (part tube (difference (cylinder r h)
                          (cylinder (- r wall) h))))

; Expression forms
(define wall-thickness 2)

(define-component mounting-bracket
  (params (number width 40))
  (part bracket (box width width 10)))

(define make-box
  (lambda (size)
    (box size size size)))

(if useCap
    (sphere radius)
    (cylinder radius height))

; Quoted expression
(quote (center center min))

; Alternative quote syntax
'(center center min)

(list x y z)

(append front-points back-points)

(reverse points)

(range 8)

(map (lambda (i) (* i 10)) (range 4))

(filter (lambda (i) (even? i)) (range 8))

(fold + 0 (range 5))

(reduce * 1 numbers)

(zip xs ys)

(enumerate (range 4))

(linspace 0 360 12)

(flat-map (lambda (i) (list i (- i))) (range 3))

(concat-map (lambda (p) (list p)) points)

(apply union cutters)

; Numeric helpers
(+ width clearance)

(- outer inner)

(* radius 2)

(/ width 2)

(min wall max-wall)

(max wall 1.2)

(abs offset)

(floor segments)

(sin (deg->rad 45))

(cos (deg->rad 45))

(tan (deg->rad 45))

(atan slope)

(atan2 y x)

(deg angle-rad)

(rad 90)

(deg->rad 90)

(rad->deg pi-angle)

(clamp depth 0 3)

(lerp 10 20 0.25)

(smoothstep 0 1 t)

(hash01 ix iy seed)

(hash-signed ix iy seed)

(noise2 (* x 0.1) (* y 0.1) seed)

(fbm2 x y seed 4 2.0 0.5)

(voronoi2 (* x 0.15) (* y 0.15) seed)

(cell-distance2 x y seed)

(pi)

(tau)

(invlerp 0 1 0.5)

(remap 0 1 10 20 0.5)

(square 3)

(cube 2)

; Point list helpers
(vec2 x y)

(vec3 x y z)

(jitter2 10 20 2 seed)

(jittered-grid 4 6 12 12 2 seed)

(polar-points 32 20)

(organic-loop 32 30 4 seed)

(wave-loop 48 20 3 5 0)

(superellipse-point (deg->rad 45) 30 20 4)

(voronoi-cells 4 6 14 12 2 seed)

(lorenz-points 80 0.01 4)

(rossler-points 80 0.03 6)

(logistic-bifurcation-points 24 8 16 30)

(henon-points 100 12)

; Boolean helpers
(not value)

(and a b c)

(or x y z)

(= a b)

(> a b)

(>= a b)

(< a b)

(<= a b)

(even? number)

(odd? number)


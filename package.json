{
  "name": "ecky-cad",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:web\"",
    "dev:web": "vite",
    "dev:server": "tsx watch server/index.ts",
    "build": "vite build",
    "build:book": "tsx scripts/build_ecky_ir_book.ts",
    "build:mission-assets": "node scripts/render_ecky_preview_png.mjs --ecky docs/books/ecky-ir/examples/corner-bracket.ecky --png public/docs/assets/corner-bracket.png && node scripts/render_ecky_preview_png.mjs --ecky docs/books/ecky-ir/examples/dovetail-fit.ecky --png public/docs/assets/dovetail-fit.png",
    "check:mission-assets": "tsx --test src/lib/docs/eckyMissionAssets.test.ts",
    "sync:book-source": "tsx scripts/sync_ecky_ir_sources.ts",
    "check:book-source": "tsx scripts/sync_ecky_ir_sources.ts --check",
    "preview": "vite preview",
    "tauri": "node scripts/run_tauri.mjs",
    "runtimes:prepare": "npm run occt:prepare && npm run speech:prepare",
    "occt:prepare": "bash scripts/prepare_occt_runtime.sh",
    "mcp:smoke": "bash scripts/mcp_preview_commit_smoke.sh",
    "guard:db-writes": "bash scripts/guard_no_direct_db_write.sh",
    "speech:prepare": "bash scripts/prepare_speech_runtime.sh",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json && tsc --project tsconfig.node.json --noEmit",
    "generate:contracts": "cargo run --manifest-path src-tauri/Cargo.toml --features tooling --bin export_contracts",
    "check:contracts": "npm run generate:contracts && git diff --exit-code -- src/lib/tauri/contracts.ts",
    "generate:skill": "cargo run --manifest-path src-tauri/Cargo.toml --features tooling --bin export_mcp_skill",
    "generate:prompt": "cargo run --manifest-path src-tauri/Cargo.toml --features tooling --bin export_agent_prompt",
    "generate:docs": "npm run sync:book-source && npm run generate:prompt && npm run build:book && npm run build:docs-site && npm run generate:skill",
    "check:skill": "npm run generate:skill && git diff --exit-code -- skills/ecky-mcp/reference",
    "test:unit": "tsx --test src/lib/**/*.test.ts",
    "test:component": "vitest run",
    "test:rust:clean": "bash scripts/test_rust_and_clean.sh",
    "clean:rust-artifacts": "cargo clean --manifest-path src-tauri/Cargo.toml -p ecky_cad -p ecky-fem",
    "test:e2e:ci": "playwright test e2e/app.spec.ts e2e/config.spec.ts e2e/layout.spec.ts e2e/genie.spec.ts e2e/params.spec.ts",
    "test:e2e": "playwright test",
    "test:editors": "node scripts/test_editor_support.mjs && emacs -Q --batch -L editors/emacs -l editors/emacs/test-ecky-mode.el",
    "start": "tsx server/index.ts",
    "prepare": "git config core.hooksPath .githooks",
    "build:docs-site": "tsx scripts/build_ecky_ir_docs_site.ts"
  },
  "dependencies": {
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.12.2",
    "@codemirror/state": "^6.5.4",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.39.16",
    "@tauri-apps/api": "^2.5.0",
    "@tauri-apps/plugin-dialog": "2.6.0",
    "@tauri-apps/plugin-fs": "2.4.5",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/xterm": "^6.0.0",
    "codemirror": "^6.0.2",
    "dotenv": "^16.6.1",
    "execa": "^9.6.0",
    "express": "^4.21.2",
    "katex": "^0.16.47",
    "marked": "^18.0.11",
    "mermaid": "^11.17.2",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@playwright/test": "^1.60.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@tauri-apps/cli": "^2.5.0",
    "@testing-library/svelte": "^5.4.2",
    "@types/express": "^4.17.23",
    "@types/node": "^24.7.2",
    "@types/three": "^0.180.0",
    "concurrently": "^9.2.1",
    "jsdom": "^29.1.1",
    "svelte": "^5.28.1",
    "svelte-check": "^4.4.5",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^6.3.5",
    "vitest": "^4.1.10"
  }
}

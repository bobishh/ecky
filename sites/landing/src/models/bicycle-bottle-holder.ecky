;; Dovetail: Bottle Holder Frame Mount Rail (12/21 x 4.5 mm).
;; Thread profile: filament dryer - final, roof filament fitting.
;; Copied profile rules, paired radial/axial allowances, and root overlap.
(define (dryer-small-thread-pitch nozzle-diameter) (* nozzle-diameter 5))
(define (dryer-small-thread-base-width nozzle-diameter) (* nozzle-diameter 4))
(define (dryer-small-thread-crest-width nozzle-diameter) nozzle-diameter)
(define (dryer-small-thread-depth nozzle-diameter) (* nozzle-diameter 1.5))

(define (dryer-clamp-male core-radius nozzle length)
  (let* ((root-overlap 0.3mm)
         (depth (dryer-small-thread-depth nozzle))
         (base-width (dryer-small-thread-base-width nozzle))
         (thread-lead (/ base-width 2)))
    (union
      (cylinder core-radius length)
      (translate 0 0 thread-lead
        (helical-ridge :radius (- core-radius root-overlap)
          :pitch (dryer-small-thread-pitch nozzle) :height (- length base-width)
          :depth (+ depth root-overlap)
          :base-width base-width
          :crest-width (dryer-small-thread-crest-width nozzle))))))

(define (dryer-clamp-female core-radius nozzle length radial-fit axial-fit)
  (let* ((root-overlap 0.3mm)
         (bore-radius (+ core-radius radial-fit))
         (male-base-width (dryer-small-thread-base-width nozzle))
         (thread-lead (/ male-base-width 2)))
    (union
      (cylinder bore-radius length)
      (translate 0 0 thread-lead
        (helical-ridge :radius (- bore-radius root-overlap)
          :pitch (dryer-small-thread-pitch nozzle) :height (- length male-base-width)
          :depth (+ (dryer-small-thread-depth nozzle) root-overlap)
          :base-width (+ male-base-width axial-fit)
          :crest-width (+ (dryer-small-thread-crest-width nozzle) axial-fit))))))

(define (clamp-axis y z body)
  (translate 0 y z (rotate 90deg 0deg 0deg body)))

(define (clamp-inward-axis y z body)
  (translate 0 y z (rotate -90deg 0deg 0deg body)))

(define (across-handlebar width section)
  (rotate 0deg 0deg 90deg
    (rotate 90deg 0deg 0deg (extrude section width :symmetric #t))))

;; Smooth native BRep outline; the screw seat grows out of the ring wall.
(define (ring-envelope radius screw-z seat-y width mounting-y rail-length rail-rise)
  (let* ((half-rail (/ rail-length 2))
         (rail-top (+ rail-rise half-rail))
         (rail-tip-projection 0.5mm)
         (shoulder-blend-height 2mm)
         (roof (max (+ screw-z 13mm) (- rail-top rail-tip-projection)))
         (mounting-bottom (min 0mm (- rail-rise half-rail)))
         (mounting-top (max half-rail (- (min rail-top roof) shoulder-blend-height)))
         (lower-y (* radius 0.6))
         (lower-z (* radius -0.8))
         (blend-rise (- mounting-bottom lower-z))
         (tangent-rise (* blend-rise 0.35)))
    (across-handlebar width
      (bspline (append
        (map (lambda (i)
          (let* ((angle (lerp pi 5.355890089177974 (/ i 64))))
            (list (* radius (cos angle)) (* radius (sin angle))))) (range 65))
        (map (lambda (i)
          (let* ((t (/ (+ i 1) 24)))
            (list (cubic-value lower-y (+ lower-y (* tangent-rise (/ 4 3))) mounting-y mounting-y t)
              (cubic-value lower-z (+ lower-z tangent-rise)
                (- mounting-bottom (* blend-rise 0.35)) mounting-bottom t)))) (range 24))
        (map (lambda (i) (list mounting-y (lerp mounting-bottom mounting-top (/ (+ i 1) 32)))) (range 32))
        (map (lambda (i)
          (let* ((t (/ (+ i 1) 48)))
            (list (cubic-value mounting-y mounting-y seat-y 12mm t)
              (cubic-value mounting-top roof roof roof t)))) (range 48))
        (map (lambda (i) (list (lerp 12mm -12mm (/ (+ i 1) 24)) roof)) (range 24))
        (map (lambda (i)
          (let* ((t (/ (+ i 1) 65)))
            (list (cubic-value -12mm (- radius) (- radius) (- radius) t)
              (cubic-value roof roof (* radius 0.4) 0mm t)))) (range 64)))
        :closed #t))))

(define (axial-disc y z radius width)
  (translate 0 y z (rotate 0deg 90deg 0deg
    (cylinder radius width :align '(center center center)))))

;; Cubic profile points remain native spline geometry after extrusion.
(define (cubic-value a b c d t)
  (+ (* a (- 1 t) (- 1 t) (- 1 t))
     (* 3 b t (- 1 t) (- 1 t))
     (* 3 c t t (- 1 t)) (* d t t t)))

;; Move each mask's samples along the local normal of the same scarf seam.
(define (seam-sample x z dx dz clearance)
  (let ((tangent-length (sqrt (+ (* dx dx) (* dz dz)))))
    (list (+ x (* clearance (/ dz tangent-length)))
          (- z (* clearance (/ dx tangent-length))))))

(define (cubic-slope a b c d t)
  (+ (* 3 (- b a) (- 1 t) (- 1 t))
     (* 6 (- c b) (- 1 t) t)
     (* 3 (- d c) t t)))

(define (hook-turn-sample inner wall t x0 x1 x2 x3 z0 z1 z2 z3 clearance)
  (seam-sample (* wall (cubic-value x0 x1 x2 x3 t))
    (- (+ inner (* wall (cubic-value z0 z1 z2 z3 t))))
    (- (* wall (cubic-slope x0 x1 x2 x3 t)))
    (* wall (cubic-slope z0 z1 z2 z3 t))
    clearance))

(define (hook-side-profile inner wall span clearance)
  (let* ((reach (* wall 1.05))
         (inner-end (- inner (* wall 0.4)))
         (outer-end (+ inner (* wall 1.03)))
         (mask-top (+ span clearance))
         (mask-bottom (- mask-top))
         (mask-right (+ span clearance))
         (mask-left (- (- reach) clearance))
         (points
           (append
             (map (lambda (i) (list (- clearance) (lerp mask-top 0 (/ i 18)))) (range 19))
             (map (lambda (i)
               (let ((t (/ (+ i 1) 8)))
                 (seam-sample (* reach t) (* (- inner-end) t)
                   reach (- inner-end) clearance))) (range 8))
             (map (lambda (i)
               (let ((t (- 1 (/ (+ i 1) 24))))
                 (hook-turn-sample inner wall t -0.15 0.65 1.05 1.05
                   0.7 0.7 0.2 -0.4 clearance))) (range 24))
             (map (lambda (i)
               (let ((t (/ (+ i 1) 8)))
                 (seam-sample (* wall (lerp -0.15 0.15 t))
                   (- (+ inner (* wall (lerp 0.7 0.3 t))))
                   (* wall 0.3) (* wall 0.4) clearance))) (range 8))
             (map (lambda (i)
               (let ((t (- 1 (/ (+ i 1) 24))))
                 (hook-turn-sample inner wall t -1.05 -0.95 -0.3 0.15
                   1.03 0.75 0.3 0.3 clearance))) (range 24))
             (map (lambda (i) (list mask-left
               (lerp (- outer-end) mask-bottom (/ (+ i 1) 18)))) (range 18))
             (map (lambda (i) (list (lerp mask-left mask-right (/ (+ i 1) 18))
               mask-bottom)) (range 18))
             (map (lambda (i) (list mask-right
               (lerp mask-bottom mask-top (/ (+ i 1) 36)))) (range 36))
             (map (lambda (i) (list (lerp mask-right (- clearance) (/ (+ i 1) 18))
               mask-top)) (range 17)))))
    (bspline points :closed #t)))

(define (grip radius height groove-count)
  (difference (cylinder radius height)
    (for-union (i groove-count)
      (rotate 0deg 0deg (* i (/ 360deg groove-count))
        (translate radius 0 -1mm (cylinder 0.65mm (+ height 2mm)))))))

;; Tangent transition into the flat handwheel seat; cutter stays outside the bore.
(define (handwheel-seat-clearance width outer seat start-z end-z span)
  (let* ((start-y (- (+ outer 0.5mm)))
         (end-y (- seat))
         (rise (- end-z start-z))
         (points (append
           (map (lambda (i)
             (let* ((t (/ i 24)))
               (list (cubic-value start-y start-y end-y end-y t)
                 (cubic-value start-z (+ start-z (* rise 0.4))
                   (- end-z (* rise 0.4)) end-z t)))) (range 25))
           (map (lambda (i) (list end-y (lerp end-z span (/ (+ i 1) 18)))) (range 18))
           (map (lambda (i) (list (lerp end-y (- span) (/ (+ i 1) 18)) span)) (range 18))
           (map (lambda (i) (list (- span) (lerp span start-z (/ (+ i 1) 18)))) (range 18))
           (map (lambda (i) (list (lerp (- span) start-y (/ (+ i 1) 18)) start-z)) (range 18)))))
    (across-handlebar width (bspline points :closed #t))))

(define (dovetail-rail length root-width crown-width height)
  ;; Existing mating section: 12 mm root, 21 mm crown, 4.5 mm projection.
  (let* ((half-base (/ root-width 2)) (half-top (/ crown-width 2))
         (embed 0.5mm) (cap-height half-top))
    (difference
      (translate 0 0 (- (/ length 2))
        (extrude (polygon (list
          (list (- half-base) (- embed)) (list half-base (- embed))
          (list half-top height) (list (- half-top) height))) length))
      (rotate 90deg 0deg 0deg
        (extrude (polygon (list
          (list (- half-top) (- (/ length 2) cap-height))
          (list 0 (/ length 2))
          (list half-top (- (/ length 2) cap-height))
          (list half-top (+ (/ length 2) cap-height))
          (list (- half-top) (+ (/ length 2) cap-height))))
          100mm :symmetric #t)))))


;; Assembly reuses clamp geometry; only its installed pose changes.
(define (assembled-clamp-part which bar-diameter liner-thickness clamp-wall clamp-gap thread-nozzle thread-radial-fit thread-axial-fit rail-rise)
  (let* ((inner-radius (+ (/ bar-diameter 2) liner-thickness))
         (outer-radius (+ inner-radius clamp-wall))
         (clamp-width 21mm)
         (rail-length 32mm)
         (rail-plane-y (+ outer-radius 1mm))
         (layout-jaw-spacing (+ (* 2 outer-radius) 34mm))
         (half-gap (/ clamp-gap 2))
         (cut-span 180mm)
         (core-radius 6mm)
         (head-radius 14mm)
         (head-height 8mm)
         (seat-y 22mm)
         (screw-z (+ outer-radius 6mm))
         (seat-transition-start-z 8mm)
         (seat-transition-end-z (- screw-z head-radius))
         (clear-hole-radius (+ core-radius (dryer-small-thread-depth thread-nozzle) thread-radial-fit))
         (blind-floor 4mm)
         (thread-start-y (- seat-y))
         (tap-length (- (* 2 seat-y) blind-floor))
         (bolt-end-clearance (+ clamp-gap 1.5mm))
         (bolt-length (- tap-length bolt-end-clearance))
         (shank-overlap 0.3mm)
         (shank-start (- head-height shank-overlap))
         ;; Both hooks are cut from the same annular profile, with a normal gap.
         (hook-depth (* 0.7 clamp-wall))
         (hook-fit 0.3mm)
         (half-hook-fit (/ hook-fit 2))
         (bore (axial-disc 0 0 inner-radius cut-span))
         (envelope (ring-envelope outer-radius screw-z seat-y clamp-width rail-plane-y rail-length rail-rise))
         (shell (difference envelope bore))
         (front-profile-mask (across-handlebar (+ clamp-width 2mm)
           (hook-side-profile inner-radius clamp-wall cut-span (- half-hook-fit))))
         (rear-profile-mask (across-handlebar (+ clamp-width 2mm)
           (hook-side-profile inner-radius clamp-wall cut-span half-hook-fit)))
         (closing-slot (translate 0 0 (/ cut-span 2)
           (box cut-span clamp-gap cut-span :align '(center center center))))
         (front-jaw (difference (intersection shell front-profile-mask) closing-slot))
         (rear-jaw (difference shell rear-profile-mask closing-slot))
         (front-solid
           (build
             (shape hooked-jaw front-jaw)
             (shape mating-rail (translate 0 rail-plane-y rail-rise
               (dovetail-rail rail-length 12mm 21mm 4.5mm)))
             (shape blind-thread (clamp-inward-axis thread-start-y screw-z
               (dryer-clamp-female core-radius thread-nozzle tap-length thread-radial-fit thread-axial-fit)))
             (shape threaded-jaw (difference (union hooked-jaw mating-rail) bore blind-thread))
             (result (clip-plane threaded-jaw
               :origin (list (/ clamp-width 2) 0 0)
               :normal '(1 0 0) :keep "negative"))))
         (rear-solid
           (build
             (shape hooked-jaw rear-jaw)
             (shape flat-handwheel-seat
               (handwheel-seat-clearance (+ clamp-width 2mm) outer-radius seat-y
                 seat-transition-start-z seat-transition-end-z cut-span))
             (shape bolt-clearance (clamp-inward-axis (- (+ seat-y 1mm)) screw-z
               (cylinder clear-hole-radius (+ seat-y 2mm))))
             (result (difference hooked-jaw flat-handwheel-seat bolt-clearance))))
         (bolt-solid
           (build
             (shape handwheel (grip head-radius head-height 36))
             (shape threaded-shank (translate 0 0 shank-start
               (dryer-clamp-male core-radius thread-nozzle bolt-length)))
             (shape complete-bolt (union handwheel threaded-shank))
             (result (chamfer 0.2mm :edges "bottom" complete-bolt)))))
    (if (= which 0) front-solid
      (if (= which 1) rear-solid
        (clamp-inward-axis (- (+ seat-y head-height 0.1mm)) screw-z
          (rotate 0deg 0deg -48deg bolt-solid))))))

;; Copied envelope and mating profile from Bicycle Bottle Holder.
;; Localized wall support uses the filament-dryer socket ramp principle.
(define (cage-across-x profile width)
  (rotate 0deg 0deg 90deg (rotate 90deg 0deg 0deg (extrude profile width :symmetric #t))))

(define (cage-side-6-columns web)
  (if (<= web 2mm) 30
    (if (<= web 2.5mm) 28
      (if (<= web 3mm) 26 (if (<= web 3.5mm) 25 24)))))

(define (cage-side-10-columns web)
  (if (<= web 2mm) 20 (if (<= web 2.5mm) 19 (if (<= web 3mm) 18 17))))

(define (cage-side-14-columns web)
  (if (<= web 2.5mm) 18 (if (<= web 3.5mm) 17 16)))

(define (cage-side-row cell web)
  (let* ((tiny (cage-side-6-columns web))
         (mid (cage-side-10-columns web))
         (big (cage-side-14-columns web)))
    (if (< cell tiny) 0
      (if (< cell (* 2 tiny)) 1
        (if (< cell (+ (* 2 tiny) mid)) 2
          (if (< cell (+ (* 2 tiny) (* 2 mid))) 3
            (if (< cell (+ (* 2 tiny) (* 2 mid) big)) 4
              (if (< cell (+ (* 2 tiny) (* 2 mid) (* 2 big))) 5
                (if (< cell (+ (* 2 tiny) (* 2 mid) (* 3 big))) 6 7)))))))))

(define (cage-side-row-columns row web)
  (if (< row 2) (cage-side-6-columns web)
    (if (< row 4) (cage-side-10-columns web)
      (if (< row 7) (cage-side-14-columns web) (cage-side-10-columns web)))))

(define (cage-side-row-start row web)
  (let* ((tiny (cage-side-6-columns web))
         (mid (cage-side-10-columns web))
         (big (cage-side-14-columns web)))
    (if (= row 0) 0
      (if (= row 1) tiny
        (if (= row 2) (* 2 tiny)
          (if (= row 3) (+ (* 2 tiny) mid)
            (if (= row 4) (+ (* 2 tiny) (* 2 mid))
              (if (= row 5) (+ (* 2 tiny) (* 2 mid) big)
                (if (= row 6) (+ (* 2 tiny) (* 2 mid) (* 2 big))
                  (+ (* 2 tiny) (* 2 mid) (* 3 big)))))))))))

(define (cage-side-row-size row)
  (if (< row 2) 6mm
    (if (< row 4) 10mm
      (if (< row 7) 14mm 10mm))))

(define (cage-side-row-z row web)
  (if (= row 0) 14mm
    (if (= row 1) (+ 20mm web)
      (if (= row 2) (+ 28mm (* 2 web))
        (if (= row 3) (+ 38mm (* 3 web))
          (if (= row 4) (+ 50mm (* 4 web))
            (if (= row 5) (+ 64mm (* 5 web))
              (if (= row 6) (+ 78mm (* 6 web))
                (+ 90mm (* 7 web))))))))))

(define (cage-floor-x cell)
  (if (= cell 0) 0mm     (if (= cell 1) 0mm     (if (= cell 2) -6mm     (if (= cell 3) 15.5mm     (if (= cell 4) -18.5mm     (if (= cell 5) -27.5mm     (if (= cell 6) 17mm     (if (= cell 7) 22mm     (if (= cell 8) -16mm     (if (= cell 9) -30mm     (if (= cell 10) 29mm     (if (= cell 11) 18mm     (if (= cell 12) -17.5mm     (if (= cell 13) 31mm     (if (= cell 14) 7mm     (if (= cell 15) -9.5mm     (if (= cell 16) 20mm     (if (= cell 17) 6.5mm     (if (= cell 18) 25mm     (if (= cell 19) -26.5mm     (if (= cell 20) 4.5mm 4.5mm))))))))))))))))))))))

(define (cage-floor-y cell)
  (if (= cell 0) 0mm     (if (= cell 1) 22mm     (if (= cell 2) -27.5mm     (if (= cell 3) 14mm     (if (= cell 4) -12.5mm     (if (= cell 5) 5mm     (if (= cell 6) -22mm     (if (= cell 7) -10.5mm     (if (= cell 8) 17mm     (if (= cell 9) -8.5mm     (if (= cell 10) 7.5mm     (if (= cell 11) 25.5mm     (if (= cell 12) -24.5mm     (if (= cell 13) -4mm     (if (= cell 14) 30.5mm     (if (= cell 15) 29mm     (if (= cell 16) 1.5mm     (if (= cell 17) -30.5mm     (if (= cell 18) 18mm     (if (= cell 19) 16.5mm     (if (= cell 20) -20mm -20mm))))))))))))))))))))))

(define (cage-floor-size cell)
  (if (= cell 0) 26mm     (if (= cell 1) 8mm     (if (= cell 2) 9mm     (if (= cell 3) 6mm     (if (= cell 4) 8mm     (if (= cell 5) 7mm     (if (= cell 6) 10mm     (if (= cell 7) 7mm     (if (= cell 8) 7mm     (if (= cell 9) 6mm     (if (= cell 10) 6mm     (if (= cell 11) 6mm     (if (= cell 12) 6mm     (if (= cell 13) 6mm     (if (= cell 14) 6mm     (if (= cell 15) 7mm     (if (= cell 16) 6mm     (if (= cell 17) 6mm     (if (= cell 18) 6mm     (if (= cell 19) 6mm     (if (= cell 20) 7mm 7mm))))))))))))))))))))))

(define (cage-floor-scale web)
  (/ (+ 16.5mm web) 20.5mm))

(define (cage-side-angle cell row web)
  (let* ((columns (cage-side-row-columns row web))
         (column (- cell (cage-side-row-start row web)))
         (stagger (* 0.5 (- row (* 2 (floor (/ row 2)))))))
    (* (+ column stagger) (/ 360deg columns))))

(define (closed-bottle-cage dia wall clr rail-len flex-slit-width hex-web)
  (let* (
    (in-r (+ (/ dia 2) 0.5mm)) (out-r (+ in-r wall))
    (height 130mm) (bottom-thickness 4mm)
    (slot-top (* height 0.75)) (slot-bottom (- slot-top rail-len))
    (base-width 12mm) (joint-depth 4.5mm)
    (slot-root-half (+ (/ base-width 2) clr))
    (slot-depth (+ joint-depth clr))
    ;; Preserve 45-degree flanks while extending the pocket floor for clearance.
    (slot-head-half (+ slot-root-half slot-depth))
    ;; Wide base of dovetail pocket is 2 * slot-head-half (25 mm for clr 1.0).
    ;; Provide 5.5 mm solid wall on each side of the widest part of the trapezoid.
    (socket-side-wall 5.5mm)
    (outer-root-half (+ slot-root-half socket-side-wall))
    (outer-head-half (+ slot-head-half socket-side-wall))
    (spine-width (* 2 outer-head-half))
    ;; Ensure 3 mm of solid plastic between the dovetail pocket floor and the cylinder outer wall.
    (socket-floor-wall 3mm)
    (spine-face-y (- (+ out-r socket-floor-wall slot-depth)))
    (spine-root-y (+ (- in-r) 1mm))
    (spine-depth (- spine-root-y spine-face-y))
    (ramp-height 10mm)
    (support-bottom (- slot-bottom ramp-height)) (support-top (+ slot-top ramp-height))
    (spine-profile (polygon (list
      (list spine-root-y support-bottom) (list spine-face-y slot-bottom)
      (list spine-face-y slot-top) (list spine-root-y support-top))))
    (spine-xy-profile (polygon (list
      (list (- outer-root-half) spine-face-y)
      (list outer-root-half spine-face-y)
      (list outer-head-half (+ spine-face-y slot-depth))
      (list outer-head-half spine-root-y)
      (list (- outer-head-half) spine-root-y)
      (list (- outer-head-half) (+ spine-face-y slot-depth)))))
    (spine-height (- support-top support-bottom))
    (spine-column (translate 0 0 (- support-bottom 1mm)
      (extrude spine-xy-profile (+ spine-height 2mm))))
    (spine-ramp (cage-across-x spine-profile (+ spine-width 4mm)))
    (spine (intersection spine-ramp spine-column))
    (shell (difference (cylinder out-r height)
      (translate 0 0 bottom-thickness (cylinder in-r height))))
    (inner-bore (translate 0 0 bottom-thickness (cylinder in-r (+ height 2mm))))
    (slot-y spine-face-y)
    (slot-profile (polygon (list
      (list (- slot-root-half) 0) (list slot-root-half 0)
      (list slot-head-half slot-depth) (list (- slot-head-half) slot-depth))))
    (entry-overrun 1mm) (slot-start (- support-bottom entry-overrun))
    (slot-raw (translate 0 slot-y slot-start (extrude slot-profile (- slot-top slot-start))))
    ;; Existing male rail has a matching 45-degree V end stop.
    (roof-size 150mm)
    (roof-a (translate 0 slot-y slot-top (rotate 0deg 45deg 0deg
      (box roof-size roof-size roof-size :align '(min center min)))))
    (roof-b (translate 0 slot-y slot-top (rotate 0deg -45deg 0deg
      (box roof-size roof-size roof-size :align '(max center min)))))
    (slot (difference slot-raw roof-a roof-b))
    ;; The dovetail continues through the entry ramp with one continuous floor.
    ;; Every short prism follows the local radial normal.
    (cut-overlap 2mm)
    (radial-start (- in-r cut-overlap)) (radial-depth (+ wall (* 2 cut-overlap)))
    ;; Omit entire cells near the socket, never trim a hexagonal opening.
    (socket-border 2mm)
    (socket-keepout-half (+ (/ spine-width 2) socket-border))
    (sqrt-three (* 2 (sin (/ pi 3))))
    ;; Rejected cells reuse an existing cutter; union keeps only whole openings.
    (total-side-cells (+ (* 2 (cage-side-6-columns hex-web))
                         (* 3 (cage-side-10-columns hex-web))
                         (* 3 (cage-side-14-columns hex-web))))
    (side-cutters (for-union (cell 180)
      (let* ((row (cage-side-row cell hex-web))
             (hole-radius (/ (cage-side-row-size row) 2))
             (hex-profile (regular-polygon 6 hole-radius))
             (angle (cage-side-angle cell row hex-web))
             (cell-z (cage-side-row-z row hex-web))
             (radians (* angle (/ pi 180)))
             (hex-tangent-half (* hole-radius (/ sqrt-three 2)))
             (nearest-x (- (* radial-start (abs (cos radians))) hex-tangent-half))
             (seam-cell (and (> (sin radians) 0)
               (<= (* radial-start (abs (cos radians)))
                 (+ hole-radius (/ flex-slit-width 2) 0.5mm))))
             (clear-cell (and (< cell total-side-cells)
               (not seam-cell) (or (>= (sin radians) 0)
               (>= nearest-x socket-keepout-half)
               (<= (+ cell-z hole-radius) (- support-bottom socket-border))
               (>= (- cell-z hole-radius) (+ support-top socket-border)))))
             (cut-angle (if clear-cell angle 0deg))
             (cut-radial (if clear-cell radial-start (+ 500mm (* cell 40mm))))
             (cut-z (if clear-cell cell-z 13mm)))
        (rotate 0deg 0deg cut-angle (translate cut-radial 0 cut-z
          (rotate 0deg 90deg 0deg (extrude hex-profile radial-depth)))))))
    ;; Pack the floor before cutting the slit; hex clearance is parameterized.
    (bottom-rim 6mm)
    (bottom-layout-count 21)
    (bottom-cutters (for-union (cell bottom-layout-count)
      (let* ((hole-size (cage-floor-size cell))
             (hole-radius (/ hole-size 2))
             (packing-scale (cage-floor-scale hex-web))
             (px (* packing-scale (cage-floor-x cell)))
             (py (* packing-scale (cage-floor-y cell)))
             (in-bound (<= (+ (sqrt (+ (* px px) (* py py))) hole-radius bottom-rim) in-r))
             (clear-cell in-bound)
             (cut-x (if clear-cell px (+ 500mm (* cell 40mm))))
             (cut-y (if clear-cell py 500mm)))
        (translate cut-x cut-y (- cut-overlap)
          (extrude (regular-polygon 6 hole-radius)
            (+ bottom-thickness (* 2 cut-overlap)))))))
    ;; Continuous release slit down one wall and inward across the floor;
    ;; the uncut opposite sector keeps the bottle cage as one connected part.
    (flex-slit (translate 0 (/ (+ out-r 2mm) 2) (- 1mm)
      (box flex-slit-width (+ out-r 2mm) (+ height 2mm)
        :align '(center center min))))
    ;; Continue the slit 8 mm into the centered 26 mm hex, then end inside it.
    (floor-slit-extension (translate 0 (- 4mm) (- 1mm)
      (box flex-slit-width 8mm (+ bottom-thickness 2mm)
        :align '(center center min))))
    )
    (build
      (shape closed-shell shell)
      (shape ramped-socket spine)
      (shape female-dovetail slot)
      (shape radial-hex-openings side-cutters)
      (shape bottom-hex-openings bottom-cutters)
      (shape centered-flex-relief flex-slit)
      (shape bottom-through-cut floor-slit-extension)
      (shape inner-cavity inner-bore)
      (result (difference (union closed-shell ramped-socket)
        female-dovetail radial-hex-openings bottom-hex-openings centered-flex-relief bottom-through-cut inner-cavity)))))



;; Shared assembly frame is the upward-pointing male rail tip.
(define-component clamp-module
  ((number which 0)
   (number bar 31mm) (number liner 0.5mm) (number wall 9mm)
   (number gap 3mm) (number nozzle 0.6mm)
   (number radial-fit 0.35mm) (number axial-fit 0.35mm) (number rail-rise 25mm))
  (ports (port rail-tip :type "bottle.dovetail.12-21.v1" :frame
    (frame :origin (list 0 (+ (/ bar 2) liner wall 1mm) (+ 16mm rail-rise))
      :x-axis '(1 0 0) :z-axis '(0 1 0))))
  (assembled-clamp-part which bar liner wall gap nozzle radial-fit axial-fit rail-rise))

(model
  (meta :title "Closed hex bottle holder on assembled clamp")
  (params
    (number bottle_diameter 80mm :min 60 :max 90 :label "Bottle Diameter")
    (number wall_thickness 4mm :min 2 :max 6 :label "Holder Wall")
    (number hex_web_thickness 4mm :min 2 :max 4 :step 0.5 :label "Hex Web Thickness")
    (number flex-slit-width 2mm :min 1 :max 4 :step 0.5 :label "Flex Slit Width")
    (number dovetail_clearance 1.0mm :min 0.6 :max 1.5 :step 0.1 :label "Joint Clearance")
    (number socket_length 50mm :min 40 :max 60 :label "Socket Length")
    (number bar-diameter 31mm :min 22 :max 50 :step 0.1 :label "Handlebar Diameter")
    (number liner-thickness 0.5mm :min 0.5 :max 3 :label "Liner Allowance")
    (number clamp-wall 9mm :min 9 :max 12 :label "Clamp Wall")
    (number clamp-gap 3mm :min 2 :max 5 :label "Clamp Closing Gap")
    (number thread-nozzle 0.6mm :min 0.4 :max 0.6 :label "Thread Nozzle")
    (number thread-radial-fit 0.35mm :min 0.25 :max 0.5 :label "Thread Radial Fit")
    (number thread-axial-fit 0.35mm :min 0.25 :max 0.5 :label "Thread Axial Fit")
    (number dovetail-rise 25mm :min 0 :max 35 :step 1 :label "Dovetail Rise")
    (number mount-face-gap 0.2mm :min 0 :max 0.3 :label "Assembly Face Gap")
    (number mount-stop-gap 0.4mm :min 0 :max 2 :label "Assembly Stop Gap"))
  (verify (tag four-assembled-parts) (metric pieces (stl connected-component-count)) (expect pieces (= 4)))
  (verify (tag manifold-assembly) (metric bad-edges (stl non-manifold-edge-count)) (expect bad-edges (= 0)))
  (verify (tag analytic-export) (metric step (manifest has-step)) (expect step (= true)))
    (part BottleCage
      (ports (port socket-stop :type "bottle.dovetail.12-21.v1"
        :params ((face-gap mount-face-gap) (stop-gap mount-stop-gap))
        :frame (frame :origin (list 0 (- (+ (/ bottle_diameter 2) 0.5mm wall_thickness 7.5mm dovetail_clearance)) (* 130mm 0.75))
          :x-axis '(1 0 0) :z-axis '(0 1 0))))
      (closed-bottle-cage bottle_diameter wall_thickness dovetail_clearance socket_length flex-slit-width hex_web_thickness))
    (part FrameMountRail
      (place-component (clamp-module :which 0 :bar bar-diameter :liner liner-thickness
        :wall clamp-wall :gap clamp-gap :nozzle thread-nozzle
        :radial-fit thread-radial-fit :axial-fit thread-axial-fit :rail-rise dovetail-rise)
        :from rail-tip :to (port-ref BottleCage socket-stop) :normal aligned :offset (list 0 mount-stop-gap (- mount-face-gap))))
    (part rear-clamp
      (place-component (clamp-module :which 1 :bar bar-diameter :liner liner-thickness
        :wall clamp-wall :gap clamp-gap :nozzle thread-nozzle
        :radial-fit thread-radial-fit :axial-fit thread-axial-fit :rail-rise dovetail-rise)
        :from rail-tip :to (port-ref BottleCage socket-stop) :normal aligned :offset (list 0 mount-stop-gap (- mount-face-gap))))
    (part clamp-bolt-upper
      (place-component (clamp-module :which 2 :bar bar-diameter :liner liner-thickness
        :wall clamp-wall :gap clamp-gap :nozzle thread-nozzle
        :radial-fit thread-radial-fit :axial-fit thread-axial-fit :rail-rise dovetail-rise)
        :from rail-tip :to (port-ref BottleCage socket-stop) :normal aligned :offset (list 0 mount-stop-gap (- mount-face-gap)))))

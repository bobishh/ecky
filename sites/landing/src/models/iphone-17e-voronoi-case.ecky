          (lattice-strut :x1 (- (* -0.159195 back-cell-grid-width) voronoi-junction-half-span) :y1 (* -0.098346 back-cell-grid-length) :x2 (+ (* -0.159195 back-cell-grid-width) voronoi-junction-half-span) :y2 (* -0.098346 back-cell-grid-length) :width voronoi-junction-diameter :height rear-panel-thickness)
          (lattice-strut :x1 (- (* -0.121979 back-cell-grid-width) voronoi-junction-half-span) :y1 (* -0.213265 back-cell-grid-length) :x2 (+ (* -0.121979 back-cell-grid-width) voronoi-junction-half-span) :y2 (* -0.213265 back-cell-grid-length) :width voronoi-junction-diameter :height rear-panel-thickness)
          (lattice-strut :x1 (- (* -0.109272 back-cell-grid-width) voronoi-junction-half-span) :y1 (* -0.217799 back-cell-grid-length) :x2 (+ (* -0.109272 back-cell-grid-width) voronoi-junction-half-span) :y2 (* -0.217799 back-cell-grid-length) :width voronoi-junction-diameter :height rear-panel-thickness)
          (lattice-strut :x1 (- (* 0.126703 back-cell-grid-width) voronoi-junction-half-span) :y1 (* 0.174273 back-cell-grid-length) :x2 (+ (* 0.126703 back-cell-grid-width) voronoi-junction-half-span) :y2 (* 0.174273 back-cell-grid-length) :width voronoi-junction-diameter :height rear-panel-thickness)
          (lattice-strut :x1 (- (* 0.132088 back-cell-grid-width) voronoi-junction-half-span) :y1 (* 0.188100 back-cell-grid-length) :x2 (+ (* 0.132088 back-cell-grid-width) voronoi-junction-half-span) :y2 (* 0.188100 back-cell-grid-length) :width voronoi-junction-diameter :height rear-panel-thickness)
          (lattice-strut :x1 (- (* -0.111247 back-cell-grid-width) voronoi-junction-half-span) :y1 (* -0.223265 back-cell-grid-length) :x2 (+ (* -0.111247 back-cell-grid-width) voronoi-junction-half-span) :y2 (* -0.223265 back-cell-grid-length) :width voronoi-junction-diameter :height rear-panel-thickness)))

      ;; Tapered TPU camera island. Same three-lobe topology as PETG clamp.

      (back-camera-center-x
        (- rear-camera-left (/ phone-body-width 2.0)))

      (back-camera-center-y
        (- (/ phone-body-length 2.0) rear-camera-top))

      (back-mic-center-x
        (- rear-mic-left (/ phone-body-width 2.0)))

      (back-mic-center-y
        (- (/ phone-body-length 2.0) rear-mic-top))

      (back-flash-center-x
        (- rear-flash-left (/ phone-body-width 2.0)))

      (back-flash-center-y
        (- (/ phone-body-length 2.0) rear-flash-top))

      (lens-clamp-tpu-border-width 1.4)

      (lens-support-radius
        (+ (/ lens-clamp-camera-pad-diameter 2.0)
           lens-clamp-tpu-border-width))

      (mic-support-radius
        (+ (/ lens-clamp-mic-pad-diameter 2.0)
           lens-clamp-tpu-border-width))

      (flash-support-radius
        (+ (/ lens-clamp-flash-pad-diameter 2.0)
           lens-clamp-tpu-border-width))

      (lens-support
        (translate back-camera-center-x back-camera-center-y 0
          (cylinder lens-support-radius rear-panel-thickness)))

      (mic-support
        (translate back-mic-center-x back-mic-center-y 0
          (cylinder mic-support-radius rear-panel-thickness)))

      (flash-support
        (translate back-flash-center-x back-flash-center-y 0
          (cylinder flash-support-radius rear-panel-thickness)))

      (camera-mic-support-lobe
        (hull lens-support mic-support))

      (mic-flash-support-lobe
        (hull mic-support flash-support))

      (camera-cluster-support
        (union camera-mic-support-lobe mic-flash-support-lobe))

      (rear-panel-bottom-finished
        (if use-back-cellular-pattern
          (union
            rear-panel-perimeter
            voronoi-struts
            camera-cluster-support)
          rear-panel-outer-finished))

      ;; Main side-wall ring

      (side-wall-ring-profile
        (profile
          :outer outer-case-profile
          :holes phone-pocket-profile))

      (side-wall-ring-raw
        (translate 0 0 rear-panel-thickness
          (extrude
            side-wall-ring-profile
            side-wall-height)))

      (side-wall-ring
        (chamfer
          outer-top-edge-chamfer
          :edges "top"
          side-wall-ring-raw))

      ;; Corner reinforcement starts at rear datum without entering the lattice window.

      (corner-bumper-radius
        (+ outer-case-corner-radius 1.1))

      (corner-bumper-chamfer-distance 0.8)

      (corner-bumper-total-height
        (+ rear-panel-thickness side-wall-height))

      (corner-bumper-center-x
        (- (/ outer-case-width 2.0)
           outer-case-corner-radius))

      (corner-bumper-center-y
        (- (/ outer-case-length 2.0)
           outer-case-corner-radius))

      (top-left-bumper
        (translate
          (- 0.0 corner-bumper-center-x)
          corner-bumper-center-y
          0.0
          (chamfer
            corner-bumper-chamfer-distance
            :edges "top"
            (chamfer
              corner-bumper-chamfer-distance
              :edges "bottom"
              (cylinder
                corner-bumper-radius
                corner-bumper-total-height)))))

      (top-right-bumper
        (translate
          corner-bumper-center-x
          corner-bumper-center-y
          0.0
          (chamfer
            corner-bumper-chamfer-distance
            :edges "top"
            (chamfer
              corner-bumper-chamfer-distance
              :edges "bottom"
              (cylinder
                corner-bumper-radius
                corner-bumper-total-height)))))

      (bottom-left-bumper
        (translate
          (- 0.0 corner-bumper-center-x)
          (- 0.0 corner-bumper-center-y)
          0.0
          (chamfer
            corner-bumper-chamfer-distance
            :edges "top"
            (chamfer
              corner-bumper-chamfer-distance
              :edges "bottom"
              (cylinder
                corner-bumper-radius
                corner-bumper-total-height)))))

      (bottom-right-bumper
        (translate
          corner-bumper-center-x
          (- 0.0 corner-bumper-center-y)
          0.0
          (chamfer
            corner-bumper-chamfer-distance
            :edges "top"
            (chamfer
              corner-bumper-chamfer-distance
              :edges "bottom"
              (cylinder
                corner-bumper-radius
                corner-bumper-total-height)))))

      (all-corner-bumpers
        (union
          top-left-bumper
          top-right-bumper
          bottom-left-bumper
          bottom-right-bumper))

      (corner-pocket-cutter
        (translate 0 0 rear-panel-thickness
          (extrude
            phone-pocket-profile
            side-wall-height)))

      (corner-pattern-clearance-radius
        (max 1.0
             (- phone-pocket-corner-radius
                back-cell-frame-width)))

      (corner-pattern-clearance-cutter
        (translate 0 0 (- 0.0 boolean-overlap)
          (extrude
            (rounded-rect
              back-cell-grid-width
              back-cell-grid-length
              corner-pattern-clearance-radius)
            (+ corner-bumper-total-height
               (* 2.0 boolean-overlap)))))

      (hollow-corner-bumpers
        (difference
          all-corner-bumpers
          corner-pocket-cutter
          corner-pattern-clearance-cutter))

      ;; Front retaining rim

      (front-rim-step-height
        (/ front-lip-height 3.0))

      (front-rim-middle-overlap
        (/ (+ front-rim-bottom-overlap
              front-rim-top-overlap)
           2.0))

      (rim-bottom-hole-profile
        (rounded-rect
          (- phone-pocket-width
             (* 2.0 front-rim-bottom-overlap))
          (- phone-pocket-length
             (* 2.0 front-rim-bottom-overlap))
          (- phone-pocket-corner-radius
             front-rim-bottom-overlap)))

      (rim-middle-hole-profile
        (rounded-rect
          (- phone-pocket-width
             (* 2.0 front-rim-middle-overlap))
          (- phone-pocket-length
             (* 2.0 front-rim-middle-overlap))
          (- phone-pocket-corner-radius
             front-rim-middle-overlap)))

      (rim-top-hole-profile
        (rounded-rect
          (- phone-pocket-width
             (* 2.0 front-rim-top-overlap))
          (- phone-pocket-length
             (* 2.0 front-rim-top-overlap))
          (- phone-pocket-corner-radius
             front-rim-top-overlap)))

      (rim-bottom-profile
        (profile
          :outer outer-case-profile
          :holes rim-bottom-hole-profile))

      (rim-middle-profile
        (profile
          :outer outer-case-profile
          :holes rim-middle-hole-profile))

      (rim-top-profile
        (profile
          :outer outer-case-profile
          :holes rim-top-hole-profile))

      (rim-base-z
        (+ rear-panel-thickness
           phone-body-thickness))

      (rim-bottom-solid
        (translate 0 0 rim-base-z
          (extrude
            rim-bottom-profile
            (+ front-rim-step-height boolean-overlap))))

      (rim-middle-solid
        (translate
          0
          0
          (+ rim-base-z front-rim-step-height)
          (extrude
            rim-middle-profile
            (+ front-rim-step-height boolean-overlap))))

      (rim-top-solid-raw
        (translate
          0
          0
          (+ rim-base-z
             (* 2.0 front-rim-step-height))
          (extrude
            rim-top-profile
            (+ front-rim-step-height boolean-overlap))))

      (rim-top-solid
        (chamfer
          outer-top-edge-chamfer
          :edges "top"
          rim-top-solid-raw))

      ;; Button coordinates

      (action-button-y
        (- (/ phone-body-length 2.0)
           action-button-top))

      (volume-up-button-y
        (- (/ phone-body-length 2.0)
           volume-up-button-top))

      (volume-down-button-y
        (- (/ phone-body-length 2.0)
           volume-down-button-top))

      (power-button-y
        (- (/ phone-body-length 2.0)
           power-button-top))

      (button-center-z
        (+ rear-panel-thickness
           (/ phone-body-thickness 2.0)))

      (left-outer-wall-x
        (- 0.0 (/ outer-case-width 2.0)))

      (right-outer-wall-x
        (/ outer-case-width 2.0))

      (button-pad-corner-radius 2.0)

      ;; External button pads

      (left-action-pad
        (translate
          (- left-outer-wall-x side-button-pad-raise)
          action-button-y
          button-center-z
          (rotate 0 90 0
            (extrude
              (rounded-rect
                side-button-pad-width
                action-button-length
                button-pad-corner-radius)
              (+ side-button-pad-raise boolean-overlap)))))

      (left-volume-up-pad
        (translate
          (- left-outer-wall-x side-button-pad-raise)
          volume-up-button-y
          button-center-z
          (rotate 0 90 0
            (extrude
              (rounded-rect
                side-button-pad-width
                volume-up-button-length
                button-pad-corner-radius)
              (+ side-button-pad-raise boolean-overlap)))))

      (left-volume-down-pad
        (translate
          (- left-outer-wall-x side-button-pad-raise)
          volume-down-button-y
          button-center-z
          (rotate 0 90 0
            (extrude
              (rounded-rect
                side-button-pad-width
                volume-down-button-length
                button-pad-corner-radius)
              (+ side-button-pad-raise boolean-overlap)))))

      (right-power-pad
        (translate
          (+ right-outer-wall-x side-button-pad-raise)
          power-button-y
          button-center-z
          (rotate 0 -90 0
            (extrude
              (rounded-rect
                side-button-pad-width
                power-button-length
                button-pad-corner-radius)
              (+ side-button-pad-raise boolean-overlap)))))

      ;; Positive TPU body

      (positive-case-body
        (union
          rear-panel-bottom-finished
          side-wall-ring

          hollow-corner-bumpers

          rim-bottom-solid
          rim-middle-solid
          rim-top-solid

          left-action-pad
          left-volume-up-pad
          left-volume-down-pad
          right-power-pad))

      ;; Inner button relief cutters

      (left-inner-wall-x
        (- 0.0 (/ phone-pocket-width 2.0)))

      (right-inner-wall-x
        (/ phone-pocket-width 2.0))

      (button-relief-depth
        (- side-wall-thickness
           side-button-membrane-thickness))

      ;; Phone button enters this cavity; exterior TPU membrane remains continuous.
      (phone-button-protrusion-depth 0.35)
      (phone-button-contact-clearance 0.10)
      (button-relief-entry-depth
        (+ phone-button-protrusion-depth
           phone-button-contact-clearance))

      (button-relief-cutter-depth
        (+ button-relief-depth
           button-relief-entry-depth))

      (button-relief-corner-radius 1.9)

      (action-relief-length
        (+ action-button-length
           (* 2.0 side-button-inner-relief-extra-length)))

      (volume-up-relief-length
        (+ volume-up-button-length
           (* 2.0 side-button-inner-relief-extra-length)))

      (volume-down-relief-length
        (+ volume-down-button-length
           (* 2.0 side-button-inner-relief-extra-length)))

      (power-relief-length
        (+ power-button-length
           (* 2.0 side-button-inner-relief-extra-length)))

      (left-action-relief-cutter
        (translate
          (+ left-inner-wall-x button-relief-entry-depth)
          action-button-y
          button-center-z
          (rotate 0 -90 0
            (extrude
              (rounded-rect
                side-button-inner-relief-width
                action-relief-length
                button-relief-corner-radius)
              button-relief-cutter-depth))))

      (left-volume-up-relief-cutter
        (translate
          (+ left-inner-wall-x button-relief-entry-depth)
          volume-up-button-y
          button-center-z
          (rotate 0 -90 0
            (extrude
              (rounded-rect
                side-button-inner-relief-width
                volume-up-relief-length
                button-relief-corner-radius)
              button-relief-cutter-depth))))

      (left-volume-down-relief-cutter
        (translate
          (+ left-inner-wall-x button-relief-entry-depth)
          volume-down-button-y
          button-center-z
          (rotate 0 -90 0
            (extrude
              (rounded-rect
                side-button-inner-relief-width
                volume-down-relief-length
                button-relief-corner-radius)
              button-relief-cutter-depth))))

      (right-power-relief-cutter
        (translate
          (- right-inner-wall-x button-relief-entry-depth)
          power-button-y
          button-center-z
          (rotate 0 90 0
            (extrude
              (rounded-rect
                side-button-inner-relief-width
                power-relief-length
                button-relief-corner-radius)
              button-relief-cutter-depth))))

      ;; Camera cluster coordinates

      (camera-center-x
        (- rear-camera-left
           (/ phone-body-width 2.0)))

      (camera-center-y
        (- (/ phone-body-length 2.0)
           rear-camera-top))

      (mic-center-x
        (- rear-mic-left
           (/ phone-body-width 2.0)))

      (mic-center-y
        (- (/ phone-body-length 2.0)
           rear-mic-top))

      (flash-center-x
        (- rear-flash-left
           (/ phone-body-width 2.0)))

      (flash-center-y
        (- (/ phone-body-length 2.0)
           rear-flash-top))

      ;; Flush inner-island recess follows camera, microphone, and flash lobes.

      (rear-through-cutter-height
        (+ rear-panel-thickness 1.0))

      (lens-clamp-inner-island-thickness
        (flush-insert-thickness
          rear-panel-thickness
          lens-clamp-tpu-capture-thickness))

      ;; Named flush fit: captured TPU + inner PETG equals rear-panel thickness.
      (lens-clamp-flush-stack-height
        (+ lens-clamp-tpu-capture-thickness
           lens-clamp-inner-island-thickness))

      (lens-clamp-inner-recess-depth
        (- lens-clamp-flush-stack-height
           lens-clamp-tpu-capture-thickness))

      (lens-clamp-camera-seat-radius
        (+ (/ lens-clamp-camera-pad-diameter 2.0)
           lens-clamp-fit-clearance))

      (lens-clamp-mic-seat-radius
        (+ (/ lens-clamp-mic-pad-diameter 2.0)
           lens-clamp-fit-clearance))

      (lens-clamp-flash-seat-radius
        (+ (/ lens-clamp-flash-pad-diameter 2.0)
           lens-clamp-fit-clearance))

      (lens-clamp-seat-cutter-z
        (- lens-clamp-tpu-capture-thickness boolean-overlap))

      (lens-clamp-seat-cutter-height
        (+ lens-clamp-inner-recess-depth
           (* 2.0 boolean-overlap)))

      (lens-clamp-camera-seat-pad
        (translate
          camera-center-x
          camera-center-y
          lens-clamp-seat-cutter-z
          (cylinder
            lens-clamp-camera-seat-radius
            lens-clamp-seat-cutter-height)))

      (lens-clamp-mic-seat-pad
        (translate
          mic-center-x
          mic-center-y
          lens-clamp-seat-cutter-z
          (cylinder
            lens-clamp-mic-seat-radius
            lens-clamp-seat-cutter-height)))

      (lens-clamp-flash-seat-pad
        (translate
          flash-center-x
          flash-center-y
          lens-clamp-seat-cutter-z
          (cylinder
            lens-clamp-flash-seat-radius
            lens-clamp-seat-cutter-height)))

      (lens-clamp-inner-seat-cutter
        (union
          (hull lens-clamp-camera-seat-pad lens-clamp-mic-seat-pad)
          (hull lens-clamp-mic-seat-pad lens-clamp-flash-seat-pad)))

      ;; Hidden skirt crosses TPU only at camera. Mic cutter notches this ring open.
      (lens-clamp-snap-through-radius
        (+ (/ lens-clamp-snap-neck-diameter 2.0)
           lens-clamp-fit-clearance))

      (lens-clamp-snap-through-cutter
        (translate
          camera-center-x
          camera-center-y
          (- 0.0 boolean-overlap)
          (cylinder
            lens-clamp-snap-through-radius
            (+ lens-clamp-tpu-capture-thickness
               (* 2.0 boolean-overlap)))))

      (mic-hole-cutter
        (translate
          mic-center-x
          mic-center-y
          -0.5
          (cylinder
            (/ rear-mic-hole-diameter 2.0)
            rear-through-cutter-height)))

      (flash-hole-cutter
        (translate
          flash-center-x
          flash-center-y
          -0.5
          (cylinder
            (/ rear-flash-hole-diameter 2.0)
            rear-through-cutter-height)))

      ;; USB-C bottom opening

      (bottom-cutter-depth
        (+ side-wall-thickness 12.0))

      (bottom-outer-y
        (- 0.0 (/ outer-case-length 2.0)))

      (bottom-cutter-start-y
        (+ bottom-outer-y bottom-cutter-depth))

      (usb-center-z
        (+ rear-panel-thickness
           (/ phone-body-thickness 2.0)))

      (usb-cutter
        (translate
          0
          bottom-cutter-start-y
          usb-center-z
          (rotate 90 0 0
            (extrude
              (rounded-rect
                usb-c-port-opening-width
                usb-c-port-opening-height
                2.6)
              (* 2.0 bottom-cutter-depth)))))

      ;; Bottom acoustic holes

      (bottom-port-radius
        (/ bottom-port-hole-diameter 2.0))

      (usb-half-width
        (/ usb-c-port-opening-width 2.0))

      (left-inner-port-x
        (- 0.0
           usb-half-width
           bottom-port-gap-from-usb-edge
           bottom-port-radius))

      (right-inner-port-x
        (+ usb-half-width
           bottom-port-gap-from-usb-edge
           bottom-port-radius))

      (left-port-4-x left-inner-port-x)
      (left-port-3-x (- left-port-4-x bottom-port-hole-pitch))
      (left-port-2-x (- left-port-3-x bottom-port-hole-pitch))
      (left-port-1-x (- left-port-2-x bottom-port-hole-pitch))

      (right-port-5-x right-inner-port-x)
      (right-port-6-x (+ right-port-5-x bottom-port-hole-pitch))
      (right-port-7-x (+ right-port-6-x bottom-port-hole-pitch))
      (right-port-8-x (+ right-port-7-x bottom-port-hole-pitch))

      (bottom-port-cutter-length
        (* 2.0 bottom-cutter-depth))

      (bottom-port-1
        (translate left-port-1-x bottom-cutter-start-y usb-center-z
          (rotate 90 0 0
            (cylinder bottom-port-radius bottom-port-cutter-length))))

      (bottom-port-2
        (translate left-port-2-x bottom-cutter-start-y usb-center-z
          (rotate 90 0 0
            (cylinder bottom-port-radius bottom-port-cutter-length))))

      (bottom-port-3
        (translate left-port-3-x bottom-cutter-start-y usb-center-z
          (rotate 90 0 0
            (cylinder bottom-port-radius bottom-port-cutter-length))))

      (bottom-port-4
        (translate left-port-4-x bottom-cutter-start-y usb-center-z
          (rotate 90 0 0
            (cylinder bottom-port-radius bottom-port-cutter-length))))

      (bottom-port-5
        (translate right-port-5-x bottom-cutter-start-y usb-center-z
          (rotate 90 0 0
            (cylinder bottom-port-radius bottom-port-cutter-length))))

      (bottom-port-6
        (translate right-port-6-x bottom-cutter-start-y usb-center-z
          (rotate 90 0 0
            (cylinder bottom-port-radius bottom-port-cutter-length))))

      (bottom-port-7
        (translate right-port-7-x bottom-cutter-start-y usb-center-z
          (rotate 90 0 0
            (cylinder bottom-port-radius bottom-port-cutter-length))))

      (bottom-port-8
        (translate right-port-8-x bottom-cutter-start-y usb-center-z
          (rotate 90 0 0
            (cylinder bottom-port-radius bottom-port-cutter-length))))
    )

    (difference
      positive-case-body

      left-action-relief-cutter
      left-volume-up-relief-cutter
      left-volume-down-relief-cutter
      right-power-relief-cutter

      lens-clamp-inner-seat-cutter
      lens-clamp-snap-through-cutter

      mic-hole-cutter
      flash-hole-cutter

      usb-cutter

      bottom-port-1
      bottom-port-2
      bottom-port-3
      bottom-port-4
      bottom-port-5
      bottom-port-6
      bottom-port-7
      bottom-port-8)))

  ;; ==============================================================
  ;; PART 2: FLUSH PHONE-SIDE PETG FEMALE CAMERA ISLAND
  ;; ==============================================================

  (part camera-cluster-inner-island-petg
    (let* (
      (inner-island-thickness
        (flush-insert-thickness
          rear-panel-thickness
          lens-clamp-tpu-capture-thickness))
      (preview-x 65.0)
    )

    (translate preview-x 0 0
      (lens-clamp-inner-island
        :camera-pad-diameter lens-clamp-camera-pad-diameter
        :mic-pad-diameter lens-clamp-mic-pad-diameter
        :flash-pad-diameter lens-clamp-flash-pad-diameter
        :mic-center-x lens-cluster-mic-offset-x
        :mic-center-y lens-cluster-mic-offset-y
        :flash-center-x lens-cluster-flash-offset-x
        :flash-center-y lens-cluster-flash-offset-y
        :mic-opening-diameter lens-clamp-mic-opening-diameter
        :flash-opening-diameter lens-clamp-flash-opening-diameter
        :snap-neck-diameter lens-clamp-snap-neck-diameter
        :island-thickness inner-island-thickness
        :fit-clearance lens-clamp-fit-clearance
        :snap-interference-radius lens-clamp-snap-interference-radius
        :groove-depth lens-clamp-snap-engagement-depth))))

  ;; ==============================================================
  ;; PART 3: CAMERA-SIDE PETG SNAP ISLAND; SNAP NOTCHED AT MICROPHONE
  ;; ==============================================================

  (part camera-cluster-outer-snap-island-petg
    (let* (
      (snap-skirt-length
        (+ lens-clamp-tpu-capture-thickness
           lens-clamp-snap-engagement-depth))
      (preview-x 96.0)
    )

    (translate preview-x 0 0
      (lens-clamp-outer-snap-island
        :camera-pad-diameter lens-clamp-camera-pad-diameter
        :mic-pad-diameter lens-clamp-mic-pad-diameter
        :flash-pad-diameter lens-clamp-flash-pad-diameter
        :camera-opening-diameter lens-clamp-camera-opening-diameter
        :mic-center-x lens-cluster-mic-offset-x
        :mic-center-y lens-cluster-mic-offset-y
        :flash-center-x lens-cluster-flash-offset-x
        :flash-center-y lens-cluster-flash-offset-y
        :mic-opening-diameter lens-clamp-mic-opening-diameter
        :flash-opening-diameter lens-clamp-flash-opening-diameter
        :island-thickness lens-clamp-outer-island-thickness
        :snap-neck-diameter lens-clamp-snap-neck-diameter
        :skirt-length snap-skirt-length
        :snap-interference-radius lens-clamp-snap-interference-radius
        :snap-bead-height lens-clamp-snap-engagement-depth
        :relief-slot-width lens-clamp-relief-slot-width
        :relief-slot-count lens-clamp-relief-slot-count))))
)

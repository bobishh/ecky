;; ================================================================
;; iPhone 17e reinforced TPU case
;; + hypnotic positive-edge TPU warped-Voronoi rear lattice
;; + flush two-piece PETG tapered camera island; microphone remains open
;;
;; Lattice builds connected ribs directly; no perforated back plate.
;; ================================================================


;; ----------------------------------------------------------------
;; POSITIVE TPU LATTICE HELPERS
;; ----------------------------------------------------------------

(define-component lattice-strut
  ((number x1 0.0)
   (number y1 0.0)
   (number x2 10.0)
   (number y2 0.0)
   (number width 2.0)
   (number height 1.8))

  (let* (
    (mid-x (/ (+ x1 x2) 2.0))
    (mid-y (/ (+ y1 y2) 2.0))
  )
  (extrude
    (slot-center-point mid-x mid-y x2 y2 width)
    height)))


;; ----------------------------------------------------------------
;; TWO-PIECE PETG TAPERED CAMERA ISLAND
;; ----------------------------------------------------------------

(define rear-camera-left-spec 58.20)
(define rear-camera-top-spec 13.32)
(define rear-mic-left-spec 47.22)
(define rear-mic-top-spec 13.32)
(define rear-flash-left-spec 41.84)
(define rear-flash-top-spec 13.32)

(define lens-cluster-mic-offset-x
  (- rear-mic-left-spec rear-camera-left-spec))
(define lens-cluster-mic-offset-y
  (- rear-camera-top-spec rear-mic-top-spec))
(define lens-cluster-flash-offset-x
  (- rear-flash-left-spec rear-camera-left-spec))
(define lens-cluster-flash-offset-y
  (- rear-camera-top-spec rear-flash-top-spec))

(define (flush-insert-thickness panel-thickness captured-thickness)
  (- panel-thickness captured-thickness))


(define-component lens-clamp-inner-island
  ((number camera-pad-diameter 22.0)
   (number mic-pad-diameter 6.8)
   (number flash-pad-diameter 10.4)
   (number mic-center-x -10.98)
   (number mic-center-y 0.0)
   (number flash-center-x -16.36)
   (number flash-center-y 0.0)
   (number mic-opening-diameter 4.2)
   (number flash-opening-diameter 8.2)
   (number snap-neck-diameter 18.2)
   (number island-thickness 0.8)
   (number fit-clearance 0.18)
   (number snap-interference-radius 0.24)
   (number groove-depth 0.35))

  (let* (
    (camera-pad-radius (/ camera-pad-diameter 2.0))
    (mic-pad-radius (/ mic-pad-diameter 2.0))
    (flash-pad-radius (/ flash-pad-diameter 2.0))
    (snap-neck-radius (/ snap-neck-diameter 2.0))
    (base-bore-radius (+ snap-neck-radius fit-clearance))
    (groove-radius
      (+ snap-neck-radius snap-interference-radius fit-clearance))
    (through-height (+ island-thickness 1.0))

    (camera-pad (cylinder camera-pad-radius island-thickness))
    (mic-pad
      (translate mic-center-x mic-center-y 0
        (cylinder mic-pad-radius island-thickness)))
    (flash-pad
      (translate flash-center-x flash-center-y 0
        (cylinder flash-pad-radius island-thickness)))

    ;; Two blended spans keep a deliberate waist around the microphone.
    (camera-mic-lobe (hull camera-pad mic-pad))
    (mic-flash-lobe (hull mic-pad flash-pad))
    (island-blank (union camera-mic-lobe mic-flash-lobe))

    (camera-bore-cutter
      (translate 0 0 -0.5
        (cylinder base-bore-radius through-height)))
    (mic-opening-cutter
      (translate mic-center-x mic-center-y -0.5
        (cylinder (/ mic-opening-diameter 2.0) through-height)))
    (flash-opening-cutter
      (translate flash-center-x flash-center-y -0.5
        (cylinder (/ flash-opening-diameter 2.0) through-height)))

    ;; Female undercut opens toward TPU and captures the outer snap skirt.
    (camera-groove-cutter
      (translate 0 0 -0.1
        (cylinder groove-radius (+ groove-depth 0.1))))
  )

  (difference
    island-blank
    camera-bore-cutter
    camera-groove-cutter
    mic-opening-cutter
    flash-opening-cutter)))


(define-component lens-clamp-outer-snap-island
  ((number camera-pad-diameter 22.0)
   (number mic-pad-diameter 6.8)
   (number flash-pad-diameter 10.4)
   (number camera-opening-diameter 16.6)
   (number mic-center-x -10.98)
   (number mic-center-y 0.0)
   (number flash-center-x -16.36)
   (number flash-center-y 0.0)
   (number mic-opening-diameter 4.2)
   (number flash-opening-diameter 8.2)
   (number island-thickness 1.2)
   (number snap-neck-diameter 18.2)
   (number skirt-length 1.15)
   (number snap-interference-radius 0.24)
   (number snap-bead-height 0.35)
   (number relief-slot-width 0.7)
   (number relief-slot-count 3))

  (let* (
    (camera-pad-radius (/ camera-pad-diameter 2.0))
    (mic-pad-radius (/ mic-pad-diameter 2.0))
    (flash-pad-radius (/ flash-pad-diameter 2.0))
    (camera-opening-radius (/ camera-opening-diameter 2.0))
    (snap-neck-radius (/ snap-neck-diameter 2.0))
    (snap-bead-radius
      (+ snap-neck-radius snap-interference-radius))
    (through-height
      (+ island-thickness skirt-length snap-bead-height 1.0))

    (camera-pad (cylinder camera-pad-radius island-thickness))
    (mic-pad
      (translate mic-center-x mic-center-y 0
        (cylinder mic-pad-radius island-thickness)))
    (flash-pad
      (translate flash-center-x flash-center-y 0
        (cylinder flash-pad-radius island-thickness)))
    (camera-mic-lobe (hull camera-pad mic-pad))
    (mic-flash-lobe (hull mic-pad flash-pad))
    (island-blank (union camera-mic-lobe mic-flash-lobe))

    (camera-opening-cutter
      (translate 0 0 -0.5
        (cylinder camera-opening-radius through-height)))
    (mic-opening-cutter
      (translate mic-center-x mic-center-y -0.5
        (cylinder (/ mic-opening-diameter 2.0) through-height)))
    (flash-opening-cutter
      (translate flash-center-x flash-center-y -0.5
        (cylinder (/ flash-opening-diameter 2.0) through-height)))

    (outer-island
      (difference
        island-blank
        camera-opening-cutter
        mic-opening-cutter
        flash-opening-cutter))

    (snap-skirt
      (difference
        (translate 0 0 island-thickness
          (cylinder snap-neck-radius skirt-length))
        camera-opening-cutter))

    (snap-bead-start-z
      (+ island-thickness skirt-length (- 0.0 snap-bead-height)))
    (snap-bead
      (difference
        (translate 0 0 snap-bead-start-z
          (cone snap-bead-radius snap-neck-radius snap-bead-height))
        camera-opening-cutter))

    ;; Three radial slots flex the hidden skirt; visible island remains continuous.
    (relief-slot-start-radius (- camera-opening-radius 0.2))
    (relief-slot-length
      (- (+ snap-bead-radius 0.2) relief-slot-start-radius))
    (relief-slot-height (+ skirt-length 0.15))
    (relief-slots
      (repeat-union slot-index relief-slot-count
        (rotate 0 0 (* slot-index (/ 360.0 relief-slot-count))
          (translate relief-slot-start-radius 0.0 (- island-thickness 0.05)
            (box
              relief-slot-length
              relief-slot-width
              relief-slot-height
              :align '(min center min))))))
  )

  (difference
    (union outer-island snap-skirt snap-bead)
    relief-slots)))


;; ================================================================
;; COMPLETE THREE-PART MODEL
;; ================================================================

(model
  (params
    ;; Print/backend controls

    (toggle use-back-cellular-pattern #t
      :label "Use Back Edge Lattice")

    ;; TPU fit

    (number phone-pocket-clearance 0.0
      :label "Phone Pocket Clearance Per Side"
      :min -0.15
      :max 0.40
      :step 0.05
      :unit length)

    (number side-wall-thickness 2.6
      :label "Side Wall Thickness"
      :min 1.8
      :max 4.0
      :step 0.1
      :unit length)

    (number rear-panel-thickness 1.7
      :label "Rear Panel Thickness"
      :min 1.2
      :max 2.8
      :step 0.1
      :unit length)

    ;; Edge finishing

    (number outer-top-edge-chamfer 0.65
      :label "Outer Top Edge Chamfer"
      :min 0.1
      :max 1.2
      :step 0.05
      :unit length)

    (number outer-bottom-edge-chamfer 0.45
      :label "Outer Bottom Edge Chamfer"
      :min 0.1
      :max 1.0
      :step 0.05
      :unit length)

    ;; Front retaining rim

    (number front-lip-height 1.2
      :label "Front Lip Height"
      :min 0.7
      :max 2.0
      :step 0.1
      :unit length)

    (number front-rim-bottom-overlap 1.05
      :label "Front Rim Bottom Overlap"
      :min 0.5
      :max 1.5
      :step 0.05
      :unit length)

    (number front-rim-top-overlap 0.35
      :label "Front Rim Top Overlap"
      :min 0.1
      :max 0.8
      :step 0.05
      :unit length)

    ;; Positive warped-Voronoi rear web

    (number back-voronoi-web-width 1.6
      :label "Voronoi Web Width"
      :min 1.4
      :max 2.4
      :step 0.1
      :unit length)

    ;; Ports


    (number rear-mic-hole-diameter 2.4
      :label "TPU Mic Hole Diameter"
      :min 1.5
      :max 4.0
      :step 0.1
      :unit length)

    (number rear-flash-hole-diameter 7.2
      :label "TPU Flash Hole Diameter"
      :min 5.0
      :max 10.0
      :step 0.1
      :unit length)

    (number usb-c-port-opening-width 16.8
      :label "USB-C Opening Width"
      :min 12.0
      :max 21.0
      :step 0.1
      :unit length)

    (number usb-c-port-opening-height 9.0
      :label "USB-C Opening Height"
      :min 5.0
      :max 12.0
      :step 0.1
      :unit length)

    (number bottom-port-hole-diameter 1.8
      :label "Bottom Port Hole Diameter"
      :min 1.2
      :max 3.0
      :step 0.1
      :unit length)

    (number bottom-port-hole-pitch 3.6
      :label "Bottom Port Hole Pitch"
      :min 3.0
      :max 5.0
      :step 0.1
      :unit length)

    (number bottom-port-gap-from-usb-edge 3.6
      :label "Bottom Port Gap From USB"
      :min 1.0
      :max 6.0
      :step 0.1
      :unit length)

    ;; Buttons

    (number side-button-pad-width 5.0
      :label "Button Pad Width"
      :min 4.0
      :max 6.5
      :step 0.1
      :unit length)

    (number side-button-pad-raise 0.9
      :label "Button Pad Raise"
      :min 0.4
      :max 1.4
      :step 0.1
      :unit length)

    ;; Two nominal 0.4 mm slicer lines; avoids disappearing one-line membranes.
    (number side-button-membrane-thickness 0.8
      :label "Button Membrane Thickness"
      :min 0.60
      :max 1.0
      :step 0.05
      :unit length)

    (number side-button-inner-relief-width 5.8
      :label "Button Inner Relief Width"
      :min 4.0
      :max 7.0
      :step 0.1
      :unit length)

    (number side-button-inner-relief-extra-length 3.0
      :label "Button Relief Extra Length"
      :min 1.0
      :max 5.0
      :step 0.1
      :unit length)

    ;; Two-piece PETG tapered camera island. Mic and flash stay independently open.

    (number lens-clamp-camera-pad-diameter 22.0
      :label "Camera Island Pad Diameter"
      :min 20.0
      :max 24.0
      :step 0.1
      :unit length)

    (number lens-clamp-mic-pad-diameter 6.8
      :label "Microphone Island Waist Diameter"
      :min 6.0
      :max 8.0
      :step 0.1
      :unit length)

    (number lens-clamp-flash-pad-diameter 10.4
      :label "Flash Island Pad Diameter"
      :min 9.5
      :max 12.0
      :step 0.1
      :unit length)

    (number lens-clamp-camera-opening-diameter 16.6
      :label "Camera Clear Opening"
      :min 16.0
      :max 18.0
      :step 0.1
      :unit length)

    (number lens-clamp-mic-opening-diameter 4.2
      :label "Microphone Clear Opening"
      :min 3.6
      :max 5.0
      :step 0.1
      :unit length)

    (number lens-clamp-flash-opening-diameter 8.2
      :label "Flash Clear Opening"
      :min 7.6
      :max 9.2
      :step 0.1
      :unit length)

    (number lens-clamp-outer-island-thickness 1.2
      :label "Outer Camera Island Thickness"
      :min 0.8
      :max 1.8
      :step 0.1
      :unit length)

    (number lens-clamp-snap-neck-diameter 18.2
      :label "Hidden Camera Snap Skirt Diameter"
      :min 17.4
      :max 19.2
      :step 0.1
      :unit length)

    (number lens-clamp-tpu-capture-thickness 0.8
      :label "TPU Captured Land Thickness"
      :min 0.6
      :max 1.0
      :step 0.05
      :unit length)

    (number lens-clamp-fit-clearance 0.18
      :label "PETG Island Fit Clearance"
      :min 0.1
      :max 0.3
      :step 0.01
      :unit length)

    (number lens-clamp-snap-interference-radius 0.24
      :label "Camera Snap Interference"
      :min 0.15
      :max 0.35
      :step 0.01
      :unit length)

    (number lens-clamp-snap-engagement-depth 0.35
      :label "Inner Island Groove Depth"
      :min 0.25
      :max 0.5
      :step 0.05
      :unit length)

    (number lens-clamp-relief-slot-width 0.7
      :label "Hidden Snap Relief Slot Width"
      :min 0.5
      :max 1.0
      :step 0.05
      :unit length)

    (number lens-clamp-relief-slot-count 3
      :label "Hidden Snap Relief Slot Count"
      :min 3
      :max 3
      :step 1
      :unit count))

  (verify
    (tag preview_exists)
    (metric check (manifest has-model-stl))
    (expect check (= true)))

  (verify
    (tag all_parts_present)
    (metric count (manifest part-count))
    (expect count (= 3)))

  (verify
    (tag mesh_clean)
    (metric bad_edges (stl non-manifold-edge-count))
    (expect bad_edges (= 0)))

  (verify
    (tag back_lattice_printable)
    (metric overhang_faces (stl overhang-face-count))
    (expect overhang_faces (< 6000)))

  ;; ==============================================================
  ;; PART 1: TPU CASE
  ;; ==============================================================

  (part iphone-17e-tpu-case
    (let* (
      ;; iPhone 17e specification

      (phone-body-length 146.71)
      (phone-body-width 71.52)
      (phone-body-thickness 7.8)
      (phone-body-corner-radius 12.0)

      ;; Back-view coordinates from phone top-left

      (rear-camera-left rear-camera-left-spec)
      (rear-camera-top rear-camera-top-spec)

      (rear-mic-left rear-mic-left-spec)
      (rear-mic-top rear-mic-top-spec)

      (rear-flash-left rear-flash-left-spec)
      (rear-flash-top rear-flash-top-spec)

      ;; Button dimensions

      (action-button-length 7.54)
      (action-button-top 31.28)

      (volume-up-button-length 11.84)
      (volume-up-button-top 45.43)

      (volume-down-button-length 11.84)
      (volume-down-button-top 59.63)

      (power-button-length 18.34)
      (power-button-top 52.53)

      ;; Derived pocket/body dimensions

      (phone-pocket-width
        (+ phone-body-width
           (* 2.0 phone-pocket-clearance)))

      (phone-pocket-length
        (+ phone-body-length
           (* 2.0 phone-pocket-clearance)))

      (phone-pocket-corner-radius
        (+ phone-body-corner-radius
           phone-pocket-clearance))

      (outer-case-width
        (+ phone-pocket-width
           (* 2.0 side-wall-thickness)))

      (outer-case-length
        (+ phone-pocket-length
           (* 2.0 side-wall-thickness)))

      (outer-case-corner-radius
        (+ phone-pocket-corner-radius
           side-wall-thickness))

      (side-wall-height
        (+ phone-body-thickness
           front-lip-height))

      (boolean-overlap 0.4)

      ;; Profiles

      (outer-case-profile
        (rounded-rect
          outer-case-width
          outer-case-length
          outer-case-corner-radius))

      (phone-pocket-profile
        (rounded-rect
          phone-pocket-width
          phone-pocket-length
          phone-pocket-corner-radius))

      ;; Rear TPU material: perimeter + positive edge lattice. No full plate.

      (rear-panel-raw
        (extrude outer-case-profile rear-panel-thickness))

      (rear-panel-outer-finished
        (chamfer
          outer-bottom-edge-chamfer
          :edges "bottom"
          rear-panel-raw))

      (back-cell-frame-width
        (+ side-wall-thickness 1.4))

      (back-cell-grid-width
        (- phone-pocket-width
           (* 2.0 back-cell-frame-width)))

      (back-cell-grid-length
        (- phone-pocket-length
           (* 2.0 back-cell-frame-width)))

      ;; True Voronoi topology from 46 deterministic Fermat-spiral sites.
      ;; Component instances encode 100 shared flow-bent edges as positive TPU ribs.

      (rear-panel-inner-cutter
        (translate 0 0 (- 0.0 boolean-overlap)
          (extrude
            (rounded-rect
              back-cell-grid-width
              back-cell-grid-length
              (max 1.0
                   (- phone-pocket-corner-radius
                      back-cell-frame-width)))
            (+ rear-panel-thickness
               (* 2.0 boolean-overlap)))))

      (rear-panel-perimeter
        (difference
          rear-panel-outer-finished
          rear-panel-inner-cutter))

      (voronoi-junction-extra-width 0.5)
      (voronoi-junction-diameter (+ back-voronoi-web-width voronoi-junction-extra-width))
      (voronoi-junction-half-span 0.15)

      (voronoi-struts
        (union
          (lattice-strut :x1 (* -0.075147 back-cell-grid-width) :y1 (* 0.083087 back-cell-grid-length) :x2 (* -0.071841 back-cell-grid-width) :y2 (* 0.010807 back-cell-grid-length) :width back-voronoi-web-width :height rear-panel-thickness)
          (lattice-strut :x1 (* -0.071841 back-cell-grid-width) :y1 (* 0.010807 back-cell-grid-length) :x2 (* -0.028323 back-cell-grid-width) :y2 (* -0.006876 back-cell-grid-length) :width back-voronoi-web-width :height rear-panel-thickness)
          (lattice-strut :x1 (* -0.028323 back-cell-grid-width) :y1 (* -0.006876 back-cell-grid-length) :x2 (* -0.012934 back-cell-grid-width) :y2 (* -0.012192 back-cell-grid-length) :width back-voronoi-web-width :height rear-panel-thickness)
          (lattice-strut :x1 (* -0.012934 back-cell-grid-width) :y1 (* -0.012192 back-cell-grid-length) :x2 (* -0.001892 back-cell-grid-width) :y2 (* -0.009476 back-cell-grid-length) :width back-voronoi-web-width :height rear-panel-thickness)
          (lattice-strut :x1 (* -0.001892 back-cell-grid-width) :y1 (* -0.009476 back-cell-grid-length) :x2 (* 0.034723 back-cell-grid-width) :y2 (* 0.080102 back-cell-grid-length) :width back-voronoi-web-width :height rear-panel-thickness)
          (lattice-strut :x1 (* 0.034723 back-cell-grid-width) :y1 (* 0.080102 back-cell-grid-length) :x2 (* 0.121610 back-cell-grid-width) :y2 (* 0.109528 back-cell-grid-length) :width back-voronoi-web-width :height rear-panel-thickness)
          (lattice-strut :x1 (* 0.121775 back-cell-grid-width) :y1 (* 0.109887 back-cell-grid-length) :x2 (* -0.004047 back-cell-grid-width) :y2 (* 0.123237 back-cell-grid-length) :width back-voronoi-web-width :height rear-panel-thickness)
          (lattice-strut :x1 (* -0.004047 back-cell-grid-width) :y1 (* 0.123237 back-cell-grid-length) :x2 (* -0.049402 back-cell-grid-width) :y2 (* 0.110116 back-cell-grid-length) :width back-voronoi-web-width :height rear-panel-thickness)
          (lattice-strut :x1 (* -0.049402 back-cell-grid-width) :y1 (* 0.110116 back-cell-grid-length) :x2 (* -0.073048 back-cell-grid-width) :y2 (* 0.089656 back-cell-grid-length) :width back-voronoi-web-width :height rear-panel-thickness)
          (lattice-strut :x1 (* -0.073048 back-cell-grid-width) :y1 (* 0.089656 back-cell-grid-length) :x2 (* -0.075147 back-cell-grid-width) :y2 (* 0.083087 back-cell-grid-length) :width back-voronoi-web-width :height rear-panel-thickness)
          (lattice-strut :x1 (* 0.089654 back-cell-grid-width) :y1 (* -0.038344 back-cell-grid-length) :x2 (* 0.052467 back-cell-grid-width) :y2 (* -0.008152 back-cell-grid-length) :width back-voronoi-web-width :height rear-panel-thickness)
          (lattice-strut :x1 (* 0.052467 back-cell-grid-width) :y1 (* -0.008152 back-cell-grid-length) :x2 (* -0.001892 back-cell-grid-width) :y2 (* -0.009476 back-cell-grid-length) :width back-voronoi-web-width :height rear-panel-thickness)
          (lattice-strut :x1 (* -0.028323 back-cell-grid-width) :y1 (* -0.006876 back-cell-grid-length) :x2 (* -0.093782 back-cell-grid-width) :y2 (* -0.035153 back-cell-grid-length) :width back-voronoi-web-width :height rear-panel-thickness)
          (lattice-strut :x1 (* -0.093782 back-cell-grid-width) :y1 (* -0.035153 back-cell-grid-length) :x2 (* -0.165545 back-cell-grid-width) :y2 (* -0.024595 back-cell-grid-length) :width back-voronoi-web-width :height rear-panel-thickness)
          (lattice-strut :x1 (* -0.165545 back-cell-grid-width) :y1 (* -0.024595 back-cell-grid-length) :x2 (* -0.172388 back-cell-grid-width) :y2 (* -0.034315 back-cell-grid-length) :width back-voronoi-web-width :height rear-panel-thickness)
          (lattice-strut :x1 (* -0.172388 back-cell-grid-width) :y1 (* -0.034315 back-cell-grid-length) :x2 (* -0.180524 back-cell-grid-width) :y2 (* -0.036733 back-cell-grid-length) :width back-voronoi-web-width :height rear-panel-thickness)
          (lattice-strut :x1 (* -0.180524 back-cell-grid-width) :y1 (* -0.036733 back-cell-grid-length) :x2 (* -0.159176 back-cell-grid-width) :y2 (* -0.078139 back-cell-grid-length) :width back-voronoi-web-width :height rear-panel-thickness)
          (lattice-strut :x1 (* -0.159176 back-cell-grid-width) :y1 (* -0.078139 back-cell-grid-length) :x2 (* -0.148979 back-cell-grid-width) :y2 (* -0.090714 back-cell-grid-length) :width back-voronoi-web-width :height rear-panel-thickness)
          (lattice-strut :x1 (* -0.148979 back-cell-grid-width) :y1 (* -0.090714 back-cell-grid-length) :x2 (* -0.064781 back-cell-grid-width) :y2 (* -0.118648 back-cell-grid-length) :width back-voronoi-web-width :height rear-panel-thickness)

(model
  (params
    (number case_length 116 :label "Case length" :min 90 :max 150 :step 1)
    (number case_width 72 :label "Case width" :min 50 :max 100 :step 1)
    (number rail_root 3 :label "Rail root" :min 2 :max 6 :step 0.2)
    (number rail_head 5 :label "Rail head" :min 3 :max 8 :step 0.2)
    (number rail_height 2 :label "Rail height" :min 1 :max 5 :step 0.2)
    (number fit_clearance 0.35 :label "Dovetail clearance" :min 0.2 :max 0.6 :step 0.05)
    :relations ((> rail_head rail_root) (> rail_root fit_clearance)))
  (part grooved_case
    (let* (
      (case (box case_length case_width 12))
      (groove_root (+ rail_root (* 2 fit_clearance)))
      (groove_head (+ rail_head (* 2 fit_clearance)))
      (groove_profile (polygon (list
        (list 0 (- (/ groove_head 2)))
        (list 0 (/ groove_head 2))
        (list (- rail_height) (/ groove_root 2))
        (list (- rail_height) (- (/ groove_root 2))))))
      (groove_unit (rotate 0 90 0 (extrude groove_profile case_length)))
      (grooves (translate 0 (- (/ case_width 2) 8) 10
                (linear-array 2 0 (- case_width 16) 0 groove_unit))))
      (difference case grooves)))
  (part dovetail_lid
    (let* (
      (plate (translate 0 90 0 (extrude (rounded-rect case_length case_width 6) 2.2)))
      (rail_profile (polygon (list
        (list 0 (- (/ rail_root 2)))
        (list 0 (/ rail_root 2))
        (list (- rail_height) (/ rail_head 2))
        (list (- rail_height) (- (/ rail_head 2))))))
      (rail_unit (rotate 0 90 0 (extrude rail_profile case_length)))
      (rails (translate 0 (+ 90 (- (/ case_width 2) 8)) 0
              (linear-array 2 0 (- case_width 16) 0 rail_unit))))
      (union plate rails))))

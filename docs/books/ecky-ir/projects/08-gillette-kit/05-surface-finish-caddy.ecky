(model
  (params
    (number cup_radius 22 :label "soap cup radius" :min 16 :max 34 :step 1)
    (number wall 2.4 :label "cup wall" :min 1.6 :max 4 :step 0.2))
  ;; Kit caddy coupon: surfaced soap cup plus handle stop and paired soft trays.
  (part surface_finish_caddy
    (build
      (shape cup_profile
        (make-face
          (union
            (bspline ((18 8) (24 20) (22 34)) #f :tangents ((1 0.6) (0.5 1)))
            (path (18 8 0) (0 8 0) (0 34 0) (22 34 0)))))
      (shape cup (fillet 0.2 (shell wall (revolve cup_profile 360))))
      (shape handle_stop (chamfer 0.4 :edges "bottom" (box 36 24 4 :align '(center center min))))
      (shape drain_outline (offset 1.2 (circle 5)))
      (shape soft_outline (offset-rounded 1.4 (rounded-rect 30 16 3)))
      (shape drain (extrude drain_outline 2))
      (shape soft_tray (extrude soft_outline 2))
      (shape tapered_tray (taper 8 0.75 (rounded-rect 24 14 3)))
      (shape twisted_grip (twist 16 35 (rectangle 8 4)))
      (shape ring_stop (torus 18 1.6))
      (shape mirrored_tray (mirror "x" 0 (scale 0.8 1 1 soft_tray)))
      (result (union cup handle_stop drain soft_tray tapered_tray twisted_grip ring_stop mirrored_tray)))))
